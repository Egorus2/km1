#define UART_START_BYTE 0xFE
#define UART_STOP_BYTE 0xFF
#define UART_TX_BUF_LEN 3 + sizeof(uint32_t) + sizeof(long int)
#define ENCODER_PPR 1000
#define TIMER_PERIOD_MS 100
/* USER CODE END PD */

/* Private macro -------------------------------------------------------------*/
/* USER CODE BEGIN PM */

/* USER CODE END PM */

